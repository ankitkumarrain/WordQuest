# WordQuest Environment Variables
# Prefix with EXPO_PUBLIC_ for client-side access in Expo

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=WordQuest
EXPO_PUBLIC_APP_VERSION=1.0.0

# 100% Offline Mode - No Cloud/Firebase Storage
EXPO_PUBLIC_OFFLINE_MODE=true

