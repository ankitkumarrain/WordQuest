{
  "expo": {
    "name": "WordQuest",
    "slug": "wordquest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wordquest",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wordquest.casualgame"
    },
    "android": {
      "package": "com.wordquest.casualgame",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0E1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9114703585217020~9962380769"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "admobAppIdAndroid": "ca-app-pub-9114703585217020~9962380769"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-9114703585217020~9962380769"
  }
}
